# voice demo: everything optional. Empty = demo mode (samples + mocks), no costs.
# Edition: ru = Russian UI, GigaChat/YandexGPT + Yandex SpeechKit; intl = English UI, OpenAI/Anthropic.
EDITION=intl
# Live mode switch: default on for ru, off for intl (public intl demo is mock only)
VOICE_LIVE=
# Link to the other edition (default: https://voice-en.<DEMO_DOMAIN> / https://voice.<DEMO_DOMAIN>)
VOICE_OTHER_URL=
# ru edition (ai module reads AI_*): GigaChat / YandexGPT + Yandex SpeechKit (152-FZ)
AI_GIGACHAT_AUTH_KEY=
AI_GIGACHAT_SCOPE=GIGACHAT_API_PERS
AI_YANDEX_API_KEY=          # SpeechKit STT/TTS (+ YandexGPT together with the folder id)
AI_YANDEX_FOLDER_ID=
# intl edition, on the client's own keys: OpenAI (LLM + STT/TTS) and Anthropic
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
# Spend limits in live mode
VOICE_MAX_AUDIO_SEC=180
VOICE_MAX_UPLOAD_MB=10
VOICE_IP_PER_HOUR=6
VOICE_DAILY_LIVE=120
# Optional Telegram bot (long polling) and its LLM
VOICE_TELEGRAM_TOKEN=
VOICE_TG_LLM=
