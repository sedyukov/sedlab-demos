# All optional — defaults run the full demo on mocks (no keys).
PORT=8080
PUBLIC_URL=http://localhost:8080          # https://… for a live bot (webhook + Mini App URLs)
DATA_DIR=./data                           # booking.db (SQLite) + payments-mock.json
SALON_TZ=Europe/Moscow
PAY_METHODS=yookassa,stars                # any of: yookassa, stars
DEPOSIT_PERCENT=30
HOLD_MINUTES=15
LEAD_MINUTES=60
ADMIN_IDS=                                # Telegram user ids of the owner(s), comma-separated
DEMO_EMULATOR=true                        # browser emulator (/demo/*): emulator-signed initData, simulated Stars/card
DEMO_RESET=false                          # daily reset of demo data (public demo: true)
RATE_PER_MIN=120                          # mutating requests per IP per minute

# telegram-core
TELEGRAM_PROVIDER=mock                    # mock | telegram
TELEGRAM_BOT_TOKEN=                       # from BotFather (provider=telegram)
TELEGRAM_WEBHOOK_SECRET=                  # random if empty
TELEGRAM_SESSION_SECRET=                  # Mini App session tokens (default: derived from the bot token)
TELEGRAM_SET_WEBHOOK=true

# payments (card prepayment)
PAYMENTS_PROVIDER=mock                    # mock | yookassa | stripe
PAYMENTS_YOOKASSA_SHOP_ID=
PAYMENTS_YOOKASSA_SECRET_KEY=
PAYMENTS_MOCK_STATE_FILE=                 # default DATA_DIR/payments-mock.json

# notify (reminders, owner alerts). With TELEGRAM_PROVIDER=telegram it reuses the bot token automatically.
NOTIFY_TELEGRAM_PROVIDER=mock
